# Kopie nach apps/web/.env.local — Next lädt sie von hier, ohne Extra-Code.
# Werte ohne Anführungszeichen: KEY=wert nicht KEY="wert"
# Console: https://console.firebase.google.com
#   Zahnrad → Projekteinstellungen → Allgemein → Ihre Apps → Web (</>)

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Authentication → Sign-in method: Google und E-Mail/Passwort aktivieren.
# Authentication → Sign-in method → Google → Web-Client-ID
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Cloud → APIs & Dienste → Anmeldedaten → Web-Client
# Authorized JavaScript origins: http://localhost:3000
