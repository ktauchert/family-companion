# Kopie nach apps/mobile/.env.local — Expo lädt EXPO_PUBLIC_* von hier.
# Werte ohne Anführungszeichen: KEY=wert nicht KEY="wert"
# Dieselben Firebase-Werte wie in der Web-App, Prefix EXPO_PUBLIC_.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Firebase Console: E-Mail/Passwort-Provider an (Expo Go). Google nur Dev-Build.
# Web-Client-ID (natives Sign-In). Endet auf .apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Cloud → Web-Client → Authorized redirect URIs, z. B.:
#   https://auth.expo.io/@<expo-account>/family-companion
#   familycompanion://

# Native Android (nur Dev-Build / Store, nicht Expo Go):
#   google-services.json nach apps/mobile/ (gitignored)
#   SHA-1: npm run firebase:sha1
