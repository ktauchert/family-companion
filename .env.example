# Family Companion — Umgebungsvariablen
# Kopie nach .env.local (Root) und/oder:
#   apps/web/.env.local
#   apps/mobile/.env.local
# Diese Dateien sind gitignored. Niemals echte Keys committen.

# -----------------------------------------------------------------------------
# Firebase (Client) — Auth, Firestore, Storage
# Console: https://console.firebase.google.com → Projekt → Projekteinstellungen
# Web-App bzw. Android-App anlegen, Werte hier eintragen.
# Next.js braucht NEXT_PUBLIC_*, Expo EXPO_PUBLIC_* (gleiche Werte, anderes Prefix).
# -----------------------------------------------------------------------------

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Android: google-services.json aus der Console nach apps/mobile/ (gitignored).
# SHA-1 des Debug-Keystores in Firebase hinterlegen, sonst Google Sign-In auf Android fehl.

# -----------------------------------------------------------------------------
# Firebase Admin (nur Server, z. B. Next.js Route Handler) — Phase 1+
# Service-Account-JSON nicht ins Repo. Pfad lokal oder einzelne Felder.
# -----------------------------------------------------------------------------

# GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-adminsdk.json
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# OpenAI — Phase 4, nur Server
# -----------------------------------------------------------------------------

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
